<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kehai Clock by Makoto Koizumi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background-color: #faf9f7;
            color: #333;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Clock Variables */
        :root {
            --frame-color: #f7f7f5;
            --face-color: #f1f0ea;
            --hand-color: rgba(44, 53, 60, 0.85);
            --dot-color: #a34a56;
            --blur-amount: 14px;
        }

        .theme-concrete {
            --frame-color: #d8d9d8;
            --face-color: #d0d2d1;
            --hand-color: rgba(30, 35, 40, 0.8);
            --dot-color: #923a45;
        }

        .theme-earth {
            --frame-color: #e8e2d2;
            --face-color: #e2dcc8;
            --hand-color: rgba(50, 45, 40, 0.8);
            --dot-color: #9c4852;
        }

        /* Clock Container */
        .clock-wrapper {
            position: relative;
            width: 100%;
            max-width: 420px;
            aspect-ratio: 1 / 1;
            margin: 0 auto;
            border-radius: 50%;
            background-color: var(--frame-color);
            /* Outer shadow for the physical clock body */
            box-shadow: 
                0 25px 50px -12px rgba(0, 0, 0, 0.15),
                0 0 0 1px rgba(0,0,0,0.02);
            padding: 3%; /* Thickness of the aluminum frame */
            transition: all 0.5s ease;
        }

        /* The Frosted Glass Face */
        .clock-face {
            position: relative;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background-color: var(--face-color);
            overflow: hidden; /* Crucial: keeps blurs contained inside the dial */
            /* Inner shadow to simulate the depth between glass and face */
            box-shadow: inset 0 6px 15px rgba(0, 0, 0, 0.08);
            transition: background-color 0.5s ease;
        }

        /* Overlay to add slight glare/frosted texture to the glass */
        .glass-overlay {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0) 60%);
            box-shadow: inset 0 -4px 12px rgba(255, 255, 255, 0.6);
            pointer-events: none;
            z-index: 10;
        }

        /* Containers for rotation */
        .hand-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            will-change: transform;
        }

        /* The Blurred Hands */
        .hour-shape, .minute-shape, .second-dot {
            position: absolute;
            filter: blur(var(--blur-amount));
            transition: filter 0.3s ease;
        }

        .hour-shape {
            width: 7.5%;
            height: 18%;
            background-color: var(--hand-color);
            border-radius: 0; /* Squared edges */
            left: 46.25%;
            top: 10%; /* Closer to the edge */
        }

        .minute-shape {
            width: 7.5%;
            height: 44%;
            background-color: var(--hand-color);
            border-radius: 0; /* Squared edges */
            left: 46.25%;
            bottom: 48%; /* Extends from just past the center */
        }

        .second-dot {
            width: 13%;
            aspect-ratio: 1 / 1;
            background-color: var(--dot-color);
            border-radius: 50%;
            left: 43.5%;
            top: 15%; /* Distance from edge */
            filter: blur(10px); /* Slightly less blurred than hands for depth */
        }

        /* Interactive Controls */
        .theme-btn {
            transition: all 0.2s;
        }
        .theme-btn.active {
            border-color: #333;
            background-color: #f3f4f6;
        }
    </style>
</head>
<body class="antialiased">

    <main class="flex-grow flex flex-col items-center justify-center p-6 md:p-12">
        
        <div class="w-full max-w-4xl grid md:grid-cols-2 gap-12 items-center">
            
            <!-- Left Column: The Clock -->
            <div class="flex justify-center items-center">
                <div class="clock-wrapper" id="clock-wrapper">
                    <div class="clock-face">
                        <!-- Hour Hand -->
                        <div class="hand-container" id="hour-container">
                            <div class="hour-shape"></div>
                        </div>
                        
                        <!-- Minute Hand -->
                        <div class="hand-container" id="minute-container">
                            <div class="minute-shape"></div>
                        </div>
                        
                        <!-- Second Dot (Sweep Second) -->
                        <div class="hand-container" id="second-container">
                            <div class="second-dot"></div>
                        </div>

                        <!-- Glass Reflection Effect -->
                        <div class="glass-overlay"></div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Info & Controls -->
            <div class="flex flex-col space-y-6">
                <div>
                    <h2 class="text-sm font-medium tracking-widest text-gray-500 uppercase mb-2">Makoto Koizumi · 2004</h2>
                    <h1 class="text-3xl md:text-4xl font-light text-gray-900 mb-4">Lemnos Kehai</h1>
                    <p class="text-gray-600 leading-relaxed font-light">
                        "Kehai" (気配) translates to a hint, sign, or presence in Japanese. 
                        Designed by Makoto Koizumi, this clock was created under the philosophy that the distinct presence of a clock, and time itself, can sometimes feel unpleasant. 
                    </p>
                    <p class="text-gray-600 leading-relaxed font-light mt-3">
                        Through a translucent frosted glass, the blurred hands softly convey an ambiguous sign of time. The red dot represents the second hand, turning silently and continuously like an objet d'art.
                    </p>
                </div>

                <div class="pt-6 border-t border-gray-200">
                    <h3 class="text-sm font-medium text-gray-700 mb-3">Select Edition (Wall Material Match)</h3>
                    <div class="flex flex-wrap gap-3">
                        <button onclick="setTheme('plaster')" id="btn-plaster" class="theme-btn active px-4 py-2 text-sm border border-gray-300 rounded-full hover:bg-gray-50 flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#f1f0ea] border border-gray-300"></span>
                            Plaster (White)
                        </button>
                        <button onclick="setTheme('concrete')" id="btn-concrete" class="theme-btn px-4 py-2 text-sm border border-gray-300 rounded-full hover:bg-gray-50 flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#d0d2d1] border border-gray-300"></span>
                            Concrete (Grey)
                        </button>
                        <button onclick="setTheme('earth')" id="btn-earth" class="theme-btn px-4 py-2 text-sm border border-gray-300 rounded-full hover:bg-gray-50 flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#e2dcc8] border border-gray-300"></span>
                            Wood / Earth (Yellow)
                        </button>
                    </div>
                </div>

                <div class="pt-4 flex items-center gap-4">
                    <label for="blur-slider" class="text-sm font-medium text-gray-700 whitespace-nowrap">Adjust Frost Level:</label>
                    <input type="range" id="blur-slider" min="0" max="25" value="14" class="w-full accent-gray-600">
                </div>
            </div>

        </div>
    </main>

    <footer class="text-center py-6 text-xs text-gray-400 font-light">
        <p>Interactive web replica. Original design by Makoto Koizumi for Lemnos.</p>
    </footer>

    <script>
        // DOM Elements
        const hourContainer = document.getElementById('hour-container');
        const minuteContainer = document.getElementById('minute-container');
        const secondContainer = document.getElementById('second-container');
        
        // Clock Animation Loop
        function updateClock() {
            const now = new Date();
            
            const hours = now.getHours();
            const minutes = now.getMinutes();
            const seconds = now.getSeconds();
            const milliseconds = now.getMilliseconds();
            
            // Calculate precise angles
            // Continuous sweep for seconds (6 degrees per second + fractional part)
            const secondAngle = (seconds + (milliseconds / 1000)) * 6; 
            
            // Minutes adjust smoothly based on current seconds
            const minuteAngle = (minutes + (seconds / 60)) * 6;
            
            // Hours adjust smoothly based on current minutes
            const hourAngle = ((hours % 12) + (minutes / 60)) * 30;
            
            // Apply rotations
            hourContainer.style.transform = `rotate(${hourAngle}deg)`;
            minuteContainer.style.transform = `rotate(${minuteAngle}deg)`;
            secondContainer.style.transform = `rotate(${secondAngle}deg)`;
            
            // Loop smoothly on the browser's refresh rate (approx 60fps)
            requestAnimationFrame(updateClock);
        }
        
        // Start clock
        requestAnimationFrame(updateClock);

        // Theme switching logic
        const clockWrapper = document.getElementById('clock-wrapper');
        const buttons = {
            'plaster': document.getElementById('btn-plaster'),
            'concrete': document.getElementById('btn-concrete'),
            'earth': document.getElementById('btn-earth')
        };

        function setTheme(theme) {
            // Remove existing theme classes
            clockWrapper.classList.remove('theme-concrete', 'theme-earth');
            
            // Update active button styling
            Object.values(buttons).forEach(btn => btn.classList.remove('active'));
            buttons[theme].classList.add('active');

            // Apply new theme class if not default (plaster)
            if (theme === 'concrete') {
                clockWrapper.classList.add('theme-concrete');
            } else if (theme === 'earth') {
                clockWrapper.classList.add('theme-earth');
            }
        }

        // Blur slider logic
        const blurSlider = document.getElementById('blur-slider');
        blurSlider.addEventListener('input', (e) => {
            const blurValue = e.target.value;
            document.documentElement.style.setProperty('--blur-amount', `${blurValue}px`);
        });
    </script>
</body>
</html>