<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Momentt Clock by Gejst</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f4f4;
            color: #222;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            transition: background-color 0.5s ease;
        }

        /* Theme Variables */
        :root {
            /* Black Theme (Default) */
            --frame-color: #111111;
            --dial-r: 26;
            --dial-g: 25;
            --dial-b: 25;
            --hand-color: rgba(230, 228, 235, 0.9); /* Soft pearl white */
            --rim-highlight: rgba(255, 255, 255, 0.08);
            --rim-shadow: rgba(0, 0, 0, 0.8);
            --blur-radius: 6px;
        }

        body.theme-white {
            background-color: #e5e5e5;
            --frame-color: #e8e8e8;
            --dial-r: 248;
            --dial-g: 248;
            --dial-b: 248;
            --hand-color: rgba(30, 30, 35, 0.7); /* Soft charcoal */
            --rim-highlight: rgba(255, 255, 255, 0.8);
            --rim-shadow: rgba(0, 0, 0, 0.1);
        }

        /* Clock Architecture */
        .clock-container {
            position: relative;
            width: 100%;
            max-width: 400px;
            aspect-ratio: 1 / 1;
            margin: 0 auto;
            border-radius: 50%;
            background-color: var(--frame-color);
            /* Outer rim shadow to give it weight on the wall */
            box-shadow: 
                0 20px 40px -10px rgba(0, 0, 0, 0.3),
                0 0 0 1px rgba(0, 0, 0, 0.05);
            padding: 1.5%; /* Thin steel rim */
            transition: all 0.5s ease;
        }

        /* The Funnel Dial */
        .clock-dial {
            position: relative;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background-color: rgb(var(--dial-r), var(--dial-g), var(--dial-b));
            overflow: hidden;
            /* Inner shadow simulates the rim edge and ambient occlusion of the funnel */
            box-shadow: 
                inset 0 0 0 1px var(--rim-shadow),
                inset 2px 2px 5px var(--rim-highlight),
                inset -2px -2px 10px rgba(0,0,0,0.5);
            transition: background-color 0.5s ease;
        }

        /* Containers for Hand Rotation */
        .hand-pivot {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            will-change: transform;
        }

        /* The Blurred Hands */
        .hand {
            position: absolute;
            background-color: var(--hand-color);
            border-radius: 50px; /* Soft rounded tips */
            filter: blur(var(--blur-radius));
            transform-origin: bottom center;
            transition: background-color 0.5s ease;
        }

        .hour-hand {
            width: 3%;
            height: 28%;
            left: 48.5%;
            bottom: 50%;
        }

        .minute-hand {
            width: 2.5%;
            height: 42%;
            left: 48.75%;
            bottom: 50%;
        }

        /* THE MAGIC: The Depth Illusion Gradient
           This radial gradient perfectly matches the dial color in the center and fades to transparent.
           Because it sits ON TOP of the hands, it makes them "disappear" into the center depth 
           of the funnel, exactly like the physical frosted glass clock does.
        */
        .depth-funnel-overlay {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: radial-gradient(
                circle at center, 
                rgba(var(--dial-r), var(--dial-g), var(--dial-b), 1) 5%, 
                rgba(var(--dial-r), var(--dial-g), var(--dial-b), 0.95) 15%, 
                rgba(var(--dial-r), var(--dial-g), var(--dial-b), 0.6) 35%, 
                rgba(var(--dial-r), var(--dial-g), var(--dial-b), 0) 65%
            );
            pointer-events: none; /* Let clicks pass through if needed */
            z-index: 10;
            transition: background 0.5s ease;
        }

        /* Slight surface reflection for the acrylic glass */
        .acrylic-glass {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0) 50%);
            z-index: 20;
            pointer-events: none;
        }

        /* UI Controls */
        .color-dot {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: inline-block;
            border: 1px solid #ccc;
        }
    </style>
</head>
<body class="antialiased">

    <main class="flex-grow flex flex-col items-center justify-center p-6 md:p-12">
        
        <div class="w-full max-w-5xl grid md:grid-cols-2 gap-12 lg:gap-20 items-center">
            
            <!-- Left Column: The Clock -->
            <div class="flex justify-center items-center p-4">
                <div class="clock-container">
                    <div class="clock-dial">
                        
                        <!-- Hands Layer -->
                        <div class="hand-pivot" id="hour-pivot">
                            <div class="hand hour-hand"></div>
                        </div>
                        
                        <div class="hand-pivot" id="minute-pivot">
                            <div class="hand minute-hand"></div>
                        </div>

                        <!-- The Funnel Depth Illusion -->
                        <div class="depth-funnel-overlay"></div>
                        
                        <!-- Front Acrylic Glass Reflection -->
                        <div class="acrylic-glass"></div>
                        
                    </div>
                </div>
            </div>

            <!-- Right Column: Info & Controls -->
            <div class="flex flex-col space-y-6">
                <div>
                    <h2 class="text-xs font-medium tracking-[0.2em] text-gray-500 uppercase mb-2">Böttcher & Kayser · 2020</h2>
                    <h1 class="text-4xl md:text-5xl font-light text-gray-900 mb-6 tracking-tight">Gejst Momentt</h1>
                    
                    <div class="space-y-4 text-gray-600 font-light leading-relaxed">
                        <p>
                            The Momentt wall clock is inspired by the idea of overcoming the strict limits of time, allowing you to experience it more as a feeling than a rigid measurement.
                        </p>
                        <p>
                            To achieve this poetic effect, the clock features a matte steel housing shaped like a deep funnel, covered by diffused acrylic glass. As the hands sweep toward the center pivot, they physically recede deeper into the funnel, causing them to magically blur and disappear into the darkness.
                        </p>
                    </div>
                </div>

                <div class="pt-8 border-t border-gray-200">
                    <h3 class="text-sm font-medium text-gray-800 mb-4 uppercase tracking-wider">Select Edition</h3>
                    <div class="flex gap-4">
                        <button onclick="setTheme('black')" id="btn-black" class="group flex items-center gap-3 px-5 py-3 rounded-xl border border-gray-300 bg-white shadow-sm hover:shadow transition-all">
                            <span class="color-dot bg-[#1a1919] ring-2 ring-offset-2 ring-transparent group-focus:ring-gray-400"></span>
                            <span class="text-sm font-medium text-gray-700">Black Steel</span>
                        </button>
                        
                        <button onclick="setTheme('white')" id="btn-white" class="group flex items-center gap-3 px-5 py-3 rounded-xl border border-transparent hover:bg-gray-100 transition-all">
                            <span class="color-dot bg-[#f8f8f8]"></span>
                            <span class="text-sm font-medium text-gray-600">White Steel</span>
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <footer class="text-center py-8 text-xs text-gray-400 font-light">
        <p>Interactive web replica. Original design by Böttcher & Kayser for Gejst Denmark.</p>
    </footer>

    <script>
        const hourPivot = document.getElementById('hour-pivot');
        const minutePivot = document.getElementById('minute-pivot');
        
        // Continuous smooth sweeping clock
        function updateClock() {
            const now = new Date();
            
            const hours = now.getHours();
            const minutes = now.getMinutes();
            const seconds = now.getSeconds();
            const milliseconds = now.getMilliseconds();
            
            // Calculate precise angles for a smooth sweep
            const currentSecondWithFraction = seconds + (milliseconds / 1000);
            const currentMinuteWithFraction = minutes + (currentSecondWithFraction / 60);
            
            const minuteAngle = currentMinuteWithFraction * 6;
            const hourAngle = ((hours % 12) + (currentMinuteWithFraction / 60)) * 30;
            
            hourPivot.style.transform = `rotate(${hourAngle}deg)`;
            minutePivot.style.transform = `rotate(${minuteAngle}deg)`;
            
            requestAnimationFrame(updateClock);
        }
        
        requestAnimationFrame(updateClock);

        // Theme Switcher
        const body = document.body;
        const btnBlack = document.getElementById('btn-black');
        const btnWhite = document.getElementById('btn-white');

        function setTheme(theme) {
            if (theme === 'white') {
                body.classList.add('theme-white');
                
                // Update button active states
                btnWhite.classList.add('border-gray-300', 'bg-white', 'shadow-sm');
                btnWhite.classList.remove('border-transparent', 'hover:bg-gray-100');
                btnWhite.querySelector('.color-dot').classList.add('ring-2', 'ring-offset-2', 'ring-gray-300');
                
                btnBlack.classList.remove('border-gray-300', 'bg-white', 'shadow-sm');
                btnBlack.classList.add('border-transparent', 'hover:bg-gray-100');
                btnBlack.querySelector('.color-dot').classList.remove('ring-2', 'ring-offset-2', 'ring-gray-400', 'group-focus:ring-gray-400');

            } else {
                body.classList.remove('theme-white');
                
                // Update button active states
                btnBlack.classList.add('border-gray-300', 'bg-white', 'shadow-sm');
                btnBlack.classList.remove('border-transparent', 'hover:bg-gray-100');
                btnBlack.querySelector('.color-dot').classList.add('ring-2', 'ring-offset-2', 'group-focus:ring-gray-400');
                
                btnWhite.classList.remove('border-gray-300', 'bg-white', 'shadow-sm');
                btnWhite.classList.add('border-transparent', 'hover:bg-gray-100');
                btnWhite.querySelector('.color-dot').classList.remove('ring-2', 'ring-offset-2', 'ring-gray-300');
            }
        }
    </script>
</body>
</html>