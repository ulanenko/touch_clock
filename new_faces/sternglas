import React, { useState, useEffect } from 'react';

export default function App() {
  const [time, setTime] = useState(new Date());

  // Smooth time update using requestAnimationFrame for premium feel
  useEffect(() => {
    let animationFrameId;
    const update = () => {
      setTime(new Date());
      animationFrameId = requestAnimationFrame(update);
    };
    animationFrameId = requestAnimationFrame(update);
    return () => cancelAnimationFrame(animationFrameId);
  }, []);

  // Calculate angles for hands based on current time
  const hours = time.getHours();
  const minutes = time.getMinutes();
  const seconds = time.getSeconds();
  const milliseconds = time.getMilliseconds();

  const totalSeconds = seconds + milliseconds / 1000;
  const totalMinutes = minutes + totalSeconds / 60;
  const totalHours = (hours % 12) + totalMinutes / 60;

  const minuteAngle = totalMinutes * 6; // 360 degrees / 60 minutes
  const hourAngle = totalHours * 30; // 360 degrees / 12 hours

  // Define hours for rendering
  const evenHours = [12, 2, 4, 6, 8, 10];
  const oddHours = [1, 3, 5, 7, 9, 11];

  return (
    <div className="flex flex-col items-center justify-center min-h-screen bg-stone-200 p-4 font-sans">
      {/* Import the Jost font which closely resembles the clean, geometric typeface of the clock */}
      <style>
        {`
          @import url('https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600&display=swap');
          .clock-text { font-family: 'Jost', sans-serif; }
        `}
      </style>

      {/* Clock Container */}
      <div className="relative flex items-center justify-center bg-white rounded-full shadow-2xl overflow-hidden" style={{ width: '400px', height: '400px' }}>
        
        <svg viewBox="0 0 400 400" className="w-full h-full drop-shadow-sm">
          <defs>
            {/* Subtle gradient for the dial to give a slight 3D dome effect */}
            <linearGradient id="dial-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stopColor="#ffffff" />
              <stop offset="100%" stopColor="#f5f5f5" />
            </linearGradient>

            {/* Drop shadow for the hands (Fixed: filterUnits to prevent 0-width line bug) */}
            <filter id="hand-shadow" filterUnits="userSpaceOnUse" x="-100" y="-100" width="600" height="600">
              <feDropShadow dx="2" dy="4" stdDeviation="3" floodOpacity="0.15" />
            </filter>

            {/* Inner shadow for the bezel */}
            <filter id="inner-shadow">
              <feOffset dx="0" dy="2"/>
              <feGaussianBlur stdDeviation="3" result="offset-blur"/>
              <feComposite operator="out" in="SourceGraphic" in2="offset-blur" result="inverse"/>
              <feFlood floodColor="black" floodOpacity="0.05" result="color"/>
              <feComposite operator="in" in="color" in2="inverse" result="shadow"/>
              <feComposite operator="over" in="shadow" in2="SourceGraphic"/>
            </filter>
          </defs>

          {/* Dial Background */}
          <circle cx="200" cy="200" r="195" fill="url(#dial-grad)" />

          {/* Silver Bezel Ring */}
          <circle cx="200" cy="200" r="194" fill="none" stroke="#e6e6e6" strokeWidth="6" filter="url(#inner-shadow)" />
          <circle cx="200" cy="200" r="197" fill="none" stroke="#d0d0d0" strokeWidth="2" />

          {/* Minute Ticks */}
          {Array.from({ length: 60 }).map((_, i) => {
            // Skip ticks at the 5-minute (hour) marks
            if (i % 5 === 0) return null;
            return (
              <line
                key={`min-${i}`}
                x1="200"
                y1="25"
                x2="200"
                y2="33"
                stroke="#333"
                strokeWidth="1.5"
                transform={`rotate(${i * 6} 200 200)`}
              />
            );
          })}

          {/* Odd Hour Long Lines */}
          {oddHours.map((hour) => (
            <line
              key={`hour-line-${hour}`}
              x1="200"
              y1="25"
              x2="200"
              y2="85"
              stroke="#222"
              strokeWidth="2"
              transform={`rotate(${hour * 30} 200 200)`}
            />
          ))}

          {/* Even Hour Numbers */}
          <g className="clock-text" fill="#222" fontSize="20" fontWeight="400" textAnchor="middle" alignmentBaseline="middle">
            {evenHours.map((hour) => {
              const formattedHour = hour < 10 ? `0${hour}` : `${hour}`;
              
              // Special case: 06 is upright at the bottom
              if (hour === 6) {
                return (
                  <text key={`hour-text-${hour}`} x="200" y="345">
                    {formattedHour}
                  </text>
                );
              }

              // Special cases: 04 and 08 are flipped so their baselines face the outer edge
              if (hour === 4 || hour === 8) {
                return (
                  <text
                    key={`hour-text-${hour}`}
                    x="200"
                    y="345"
                    transform={`rotate(${hour * 30 - 180} 200 200)`}
                  >
                    {formattedHour}
                  </text>
                );
              }

              // All other even numbers (12, 02, 10) are rotated radially around the center, baseline facing center
              return (
                <text
                  key={`hour-text-${hour}`}
                  x="200"
                  y="55"
                  transform={`rotate(${hour * 30} 200 200)`}
                >
                  {formattedHour}
                </text>
              );
            })}
          </g>

          {/* Top Text Branding */}
          <g className="clock-text" textAnchor="middle">
            <text x="200" y="130" fontSize="12" fontWeight="500" letterSpacing="4.5" fill="#111">
              STERNGLAS
            </text>
            <text x="200" y="148" fontSize="6.5" fontWeight="400" letterSpacing="2.5" fill="#555">
              ZEITMESSER
            </text>
          </g>

          {/* Bottom Radio Controlled Logo and Text */}
          <g className="clock-text" textAnchor="middle">
            {/* Custom SVG Radio Waves Icon */}
            <g transform="translate(200, 260)" stroke="#444" strokeWidth="1.2" strokeLinecap="round" fill="none">
              <circle cx="0" cy="0" r="1.5" fill="#444" stroke="none" />
              {/* Left Waves */}
              <path d="M -5 -4 Q -8 0 -5 4" />
              <path d="M -9 -7 Q -13 0 -9 7" />
              {/* Right Waves */}
              <path d="M 5 -4 Q 8 0 5 4" />
              <path d="M 9 -7 Q 13 0 9 7" />
            </g>
            <text x="200" y="278" fontSize="5.5" fontWeight="500" letterSpacing="1.5" fill="#444">
              RADIO
            </text>
            <text x="200" y="287" fontSize="5.5" fontWeight="500" letterSpacing="1.5" fill="#444">
              CONTROLLED
            </text>
          </g>

          {/* Hands */}
          {/* Minute Hand */}
          <polygon
            points="198,225 202,225 202,55 200,45 198,55"
            fill="#104f8c"
            transform={`rotate(${minuteAngle} 200 200)`}
            filter="url(#hand-shadow)"
          />
          
          {/* Hour Hand */}
          <polygon
            points="197,220 203,220 203,115 200,105 197,115"
            fill="#104f8c"
            transform={`rotate(${hourAngle} 200 200)`}
            filter="url(#hand-shadow)"
          />

          {/* Center Pivot Pivot */}
          <circle cx="200" cy="200" r="7" fill="#104f8c" filter="url(#hand-shadow)" />
          <circle cx="200" cy="200" r="3" fill="#1862a8" />
          
        </svg>
      </div>
      
      {/* Decorative digital readout below (optional, helps verify time) */}
      <div className="mt-8 text-stone-400 font-medium tracking-widest text-sm clock-text">
        {time.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}
      </div>
    </div>
  );
}