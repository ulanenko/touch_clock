menu "Touch Clock"

    config TOUCH_CLOCK_OTA_MANIFEST_URL
        string "OTA manifest URL"
        default ""
        help
            HTTPS URL for the firmware manifest. The manifest should be JSON
            with "version", "url", and optional "sha256" fields.

    config TOUCH_CLOCK_OTA_ALLOW_DOWNGRADE
        bool "Allow OTA downgrade"
        default n
        help
            Allow installing a firmware version that is not newer than the
            running firmware version. This is useful for recovery testing only.

    config TOUCH_CLOCK_TELEMETRY_URL
        string "Telemetry heartbeat URL"
        default ""
        help
            Optional HTTPS URL for remote clock status heartbeats.

    config TOUCH_CLOCK_TELEMETRY_TOKEN
        string "Telemetry API token"
        default ""
        help
            Optional token sent as X-Clock-Token with every heartbeat.

    config TOUCH_CLOCK_TELEMETRY_DEVICE_ID
        string "Telemetry device ID"
        default ""
        help
            Stable device identifier. If empty, the firmware uses the station MAC.

    config TOUCH_CLOCK_TELEMETRY_INTERVAL_SECONDS
        int "Telemetry heartbeat interval seconds"
        default 300
        range 60 86400
        help
            How often the clock posts a status heartbeat when connected to Wi-Fi.

    config TOUCH_CLOCK_PERF_TOUR
        bool "Run the automated UI performance tour (diagnostics only)"
        default n
        help
            Drives every screen with a scripted virtual touch input after boot
            and prints per-step frame timing as "PERF" lines on the console.
            Never enable this in firmware that is shipped or published over OTA.

    config TOUCH_CLOCK_PERF_TOUR_START_DELAY_S
        int "Seconds after boot before the tour starts"
        depends on TOUCH_CLOCK_PERF_TOUR
        default 25

    config TOUCH_CLOCK_PERF_TOUR_LOOPS
        int "Number of tour loops"
        depends on TOUCH_CLOCK_PERF_TOUR
        default 2
        range 1 20

    config TOUCH_CLOCK_PERF_TOUR_MANUAL_ONLY
        bool "Skip the scripted tour and only monitor frames during manual use"
        depends on TOUCH_CLOCK_PERF_TOUR
        default n

    config TOUCH_CLOCK_PERF_TOUR_STYLES
        bool "Run each tour loop in the next UI style (Instrument, Orbit, Atelier)"
        depends on TOUCH_CLOCK_PERF_TOUR
        default n

config TOUCH_CLOCK_PERF_TOUR_STYLE_FIRST
        int "UI style of the first styled loop (0 Instrument, 1 Orbit, 2 Atelier)"
        depends on TOUCH_CLOCK_PERF_TOUR_STYLES
        range 0 2
        default 0

config TOUCH_CLOCK_PERF_TOUR_START_FACE
        int "Face each loop starts on (-1 keeps the current face)"
        depends on TOUCH_CLOCK_PERF_TOUR
        range -1 10
        default -1

config TOUCH_CLOCK_PERF_TOUR_THUMB_STEP
        int "Thumbnail downscale step (1 = full resolution)"
        depends on TOUCH_CLOCK_PERF_TOUR_THUMBNAILS
        range 1 8
        default 4

config TOUCH_CLOCK_PERF_TOUR_PROFILE_SEGMENTS
        string "Steps to profile with the LVGL builtin profiler (comma separated)"
        depends on TOUCH_CLOCK_PERF_TOUR
        default ""
        help
            Needs LV_USE_PROFILER and LV_USE_PROFILER_BUILTIN. The first frames of each
            listed step are traced and printed as "PROF" lines.

config TOUCH_CLOCK_PERF_TOUR_SHORT
        bool "Run a short tour (settings, night face picker, alarms) instead of the full one"
        depends on TOUCH_CLOCK_PERF_TOUR
        default n

config TOUCH_CLOCK_PERF_TOUR_MICROBENCH
        bool "Time the cost-model scenes (ui_microbench.c) instead of the tour"
        depends on TOUCH_CLOCK_PERF_TOUR
        default n

config TOUCH_CLOCK_PERF_TOUR_FACE_COSTS
        bool "Show every face in turn and time its first frames and its ticks instead of the tour"
        depends on TOUCH_CLOCK_PERF_TOUR
        default n

config TOUCH_CLOCK_PERF_TOUR_FACE_GALLERY
        bool "Capture full-resolution screenshots of every face instead of the tour"
        depends on TOUCH_CLOCK_PERF_TOUR_THUMBNAILS
        default n

config TOUCH_CLOCK_PERF_TOUR_THUMBNAILS
        bool "Dump downscaled screen thumbnails at key steps"
        depends on TOUCH_CLOCK_PERF_TOUR
        default y

endmenu
